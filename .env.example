# ==========================================================================
#  HRIS — contoh konfigurasi environment
#  Salin menjadi .env lalu isi sesuai lingkungan Anda.
# ==========================================================================

# --- WAJIB ----------------------------------------------------------------

# Koneksi MongoDB
MONGODB_URI=mongodb://localhost:27017/hris

# Kunci penanda tangan sesi. WAJIB diisi.
# Kunci ini juga dipakai untuk menandatangani tautan berkas dan mengenkripsi
# data sensitif (NIK, NPWP, rekening). Menggantinya setelah sistem berisi data
# akan membuat data lama tidak terbaca — simpan dengan aman.
# Buat dengan: openssl rand -base64 48
NEXTAUTH_SECRET=
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- OPSIONAL, SANGAT DISARANKAN -------------------------------------------

# Kunci enkripsi terpisah untuk data sensitif. Bila kosong, NEXTAUTH_SECRET
# yang dipakai. Memisahkannya memudahkan rotasi kunci sesi tanpa menyentuh data.
ENCRYPTION_KEY=

# Kunci terpisah untuk menandatangani URL berkas. Bila kosong, jatuh ke
# ENCRYPTION_KEY lalu NEXTAUTH_SECRET.
STORAGE_SIGNING_SECRET=

# Kunci yang harus dikirim penjadwal (cron) ke /api/v1/cron/daily.
# Tanpa ini, tugas harian dinonaktifkan sepenuhnya.
# Contoh pemanggilan:
#   curl -H "x-cron-secret: $CRON_SECRET" https://host/api/v1/cron/daily
CRON_SECRET=

# --- PENYIMPANAN BERKAS -----------------------------------------------------
# Pilih salah satu: local | cloudinary | supabase | r2 | minio | b2
STORAGE_PROVIDER=local

# PENTING: direktori ini harus berada DI LUAR folder public/.
# Berkas di dalam public/ disajikan statis oleh Next.js sehingga foto presensi
# dan slip gaji dapat dibuka siapa pun yang menebak alamatnya.
LOCAL_STORAGE_PATH=./storage/uploads

# --- CLOUDINARY (free tier ~25GB) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- SUPABASE STORAGE ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=

# --- CLOUDFLARE R2 (S3-compatible, tanpa egress fee) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- MINIO (self-hosted, S3-compatible) ---
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=

# --- BACKBLAZE B2 ---
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=

# --- NOTIFIKASI -------------------------------------------------------------
# Kanal email/WhatsApp dinyalakan atau dimatikan dari CMS (Pengaturan →
# Notifikasi). Bagian ini hanya menyediakan kredensial pengirimnya.

# Provider email: smtp | resend | webhook
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
RESEND_API_KEY=

# Provider WhatsApp: fonnte | twilio | qontak | webhook | none
WA_PROVIDER=none
FONNTE_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Dipakai bila EMAIL_PROVIDER atau WA_PROVIDER bernilai "webhook".
# Payload dikirim sebagai JSON POST.
NOTIFICATION_WEBHOOK_URL=

# Mekari Qontak (wajib bila WA_PROVIDER=qontak)
QONTAK_API_TOKEN=
QONTAK_CHANNEL_INTEGRATION_ID=
QONTAK_TEMPLATE_ID=
# QONTAK_BASE_URL=
# QONTAK_DEFAULT_TO_NAME=
# QONTAK_LANGUAGE_CODE=

# --- API PUBLIK & ANTI-BOT --------------------------------------------------

# Kunci untuk situs lain yang mengirim lamaran ke POST /api/v1/public/candidates
# lewat header x-api-key. Kosongkan bila hanya halaman karir sendiri yang dipakai.
PUBLIC_API_KEY=

# Cloudflare Turnstile pada form publik. Bila kosong, hanya rate limit per IP
# yang melindungi form lamaran.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- SEEDING ----------------------------------------------------------------
# Kata sandi awal akun demo saat menjalankan `npm run seed`.
# Ganti sebelum dipakai di lingkungan produksi.
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
